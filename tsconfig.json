{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ] // <- importante para reconhecer 'process', 'fs', etc.
    },
    "include": [
        "src",
        "scripts"
    ],
    "exclude": [
        "node_modules"
    ]
}